\babel@toc {english}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces System block diagram. An input image from CIFAR-10 or MNIST passes through the THz-like degradation pipeline, is normalized to the ImageNet distribution, is fed to one of the three backbones, and is classified by a global-average-pooling head.}}{6}{figure.caption.8}%
\contentsline {figure}{\numberline {2}{\ignorespaces Pipeline version 2 (US-017). The saturation lerp runs first so the grayscale luminance is computed from the un-degraded source. Additive noise and salt-and-pepper operate at the pre-upsample resolution; bicubic upsample spreads each stochastic sample over the kernel footprint, producing sensor-grain noise structure rather than fine pixel-level grain.}}{6}{figure.caption.9}%
\contentsline {figure}{\numberline {3}{\ignorespaces CIFAR-10: six fixed validation examples (deterministic seed) at clean, L1 Mild, L3 Moderate, and L5 Extreme combined degradation. Class labels above each column. Rows from top to bottom: Clean, L1, L3, L5.}}{12}{figure.caption.12}%
\contentsline {figure}{\numberline {4}{\ignorespaces CIFAR-10: per-axis isolation at L3 (Phase C). Each row shows the same six images with only the named axis active.}}{13}{figure.caption.13}%
\contentsline {figure}{\numberline {5}{\ignorespaces MNIST: combined degradation at L1, L3, L5 on six fixed validation examples.}}{14}{figure.caption.14}%
\contentsline {figure}{\numberline {6}{\ignorespaces MNIST: per-axis isolation at L3 (Phase C).}}{15}{figure.caption.15}%
\contentsline {figure}{\numberline {7}{\ignorespaces Validation accuracy vs combined degradation level. Solid curves: Phase B (no extra regularization). Dashed curves: Phase D-T3 (T3 regularization on the same pipeline). Dotted horizontal lines: Phase A clean baseline per model.}}{15}{figure.caption.18}%
\contentsline {figure}{\numberline {8}{\ignorespaces Validation accuracy vs mean PSNR per pipeline. Each marker is one trained cell; color indicates the backbone. The strong negative monotone relationship justifies treating PSNR as a low-cost proxy for downstream accuracy at design time.}}{16}{figure.caption.19}%
\contentsline {figure}{\numberline {9}{\ignorespaces Validation accuracy vs mean SSIM per pipeline.}}{16}{figure.caption.20}%
\contentsline {figure}{\numberline {10}{\ignorespaces Per-axis attribution at L3: accuracy delta vs the Phase A clean baseline. Resolution dominates on CIFAR-10; on MNIST the spread between axes is smaller because the digit shapes are tolerant of color loss and moderate blur.}}{17}{figure.caption.22}%
\contentsline {figure}{\numberline {11}{\ignorespaces Phase D recovery summary. Each bar reports the mean accuracy delta vs the Phase B v2 baseline at the same level, averaged across the five levels. T3 is the best treatment but the absolute recovery remains modest (mean $\sim 0.77$ percentage points{}) compared with the Phase B v2 collapse vs v1 ($-12.49$ percentage points{}).}}{19}{figure.caption.25}%
\contentsline {figure}{\numberline {12}{\ignorespaces Phase B2 protocol-simplification decomposition summary. The B1 to B2 accuracy gain ($\sim +4.01$ percentage points{} on average) decomposes as $\sim +3.24$ percentage points{} pure-protocol effect (saturation and noise off) and $\sim +0.77$ percentage points{} regularization effect.}}{20}{figure.caption.27}%
\contentsline {figure}{\numberline {13}{\ignorespaces Phase C2 per-axis THz attribution summary. Mean accuracy delta from L1 to L5: resolution $-27.45$ percentage points{}, blur $-6.58$ percentage points{}, salt and pepper $-5.13$ percentage points{}. Resolution is the dominant axis by a factor of approximately four.}}{20}{figure.caption.29}%
\contentsline {figure}{\numberline {14}{\ignorespaces Multi-seed variance at L3: each bar reports the mean validation accuracy across seeds $\{42, 43, 44\}$ with the standard-deviation error bar. Color encodes the phase. The $\sigma $ bars are small relative to the cross-phase deltas, which validates the cross-phase comparisons.}}{22}{figure.caption.31}%
\contentsline {figure}{\numberline {15}{\ignorespaces Reliability diagrams at Phase B L3. Top row: CIFAR-10. Bottom row: MNIST. Columns: ResNet50, DenseNet121, TransNeXt-tiny.}}{23}{figure.caption.32}%
\contentsline {figure}{\numberline {16}{\ignorespaces Reliability diagrams at Phase B L5. Top row: CIFAR-10. Bottom row: MNIST. Columns: ResNet50, DenseNet121, TransNeXt-tiny.}}{24}{figure.caption.33}%
\contentsline {figure}{\numberline {17}{\ignorespaces Confusion matrices at Phase B L5. Top row: CIFAR-10. Bottom row: MNIST. Columns: ResNet50, DenseNet121, TransNeXt-tiny.}}{24}{figure.caption.34}%
\contentsline {figure}{\numberline {18}{\ignorespaces Inference latency per image at $224 \times 224$, batch size 1, \texttt {bf16-mixed}, RTX 5070.}}{25}{figure.caption.35}%
\contentsline {figure}{\numberline {19}{\ignorespaces Planned (top) versus actual (bottom) project schedule. The actual schedule added three v4 expansion phases (Phase D regularization sweep, Phase B2 / B2-nr / C2 THz-protocol decomposition, and the US-042 multi-seed audit) on top of the original plan.}}{30}{figure.caption.37}%
