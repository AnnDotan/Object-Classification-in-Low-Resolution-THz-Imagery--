\contentsline {table}{\numberline {4}{\ignorespaces \xpg@aux {}{english}\ignorespaces Experimental phases of the 402-cell campaign. Multi-seed audit replicates are layered on top of the 24 L3 headline cells.}}{7}{table.caption.8}%
\contentsline {table}{\numberline {5}{\ignorespaces \xpg@aux {}{english}\ignorespaces Test rig and software stack.}}{12}{table.caption.11}%
