{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "THz Per-Model Hparam Priors",
  "description": "Paper-anchored Optuna search priors. Each prior must cite the source paper. Cross-property constraints (low <= high, positive ranges) are enforced by the loader in tune_all.py, not by this schema (Draft-07 cannot express them).",
  "type": "object",
  "required": ["model", "hparams"],
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical model identifier (resnet50, densenet121, transnext_base)."
    },
    "notes": {
      "type": "string",
      "description": "Free-text rationale, paper section, or operational caveats."
    },
    "hparams": {
      "type": "object",
      "required": [
        "head_lr",
        "backbone_lr",
        "weight_decay",
        "label_smoothing",
        "warmup_epochs"
      ],
      "additionalProperties": { "$ref": "#/definitions/hparam" },
      "properties": {
        "head_lr": { "$ref": "#/definitions/hparam" },
        "backbone_lr": { "$ref": "#/definitions/hparam" },
        "weight_decay": { "$ref": "#/definitions/hparam" },
        "label_smoothing": { "$ref": "#/definitions/hparam" },
        "warmup_epochs": { "$ref": "#/definitions/hparam" }
      }
    }
  },
  "definitions": {
    "hparam": {
      "oneOf": [
        {
          "type": "object",
          "required": ["distribution", "low", "high", "citation"],
          "additionalProperties": false,
          "properties": {
            "distribution": { "enum": ["uniform", "loguniform"] },
            "low": { "type": "number" },
            "high": { "type": "number" },
            "citation": { "type": "string", "minLength": 1 },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["distribution", "choices", "citation"],
          "additionalProperties": false,
          "properties": {
            "distribution": { "const": "categorical" },
            "choices": { "type": "array", "minItems": 1 },
            "citation": { "type": "string", "minLength": 1 },
            "note": { "type": "string" }
          }
        }
      ]
    }
  }
}
