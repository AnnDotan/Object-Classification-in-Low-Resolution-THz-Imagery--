outputs/
*.log
wandb/
lightning_logs/

# ─── artifacts/ — explicit per-subpath excludes ─────────────────────
# We do NOT blanket-exclude artifacts/ because gitignore semantics
# prevent re-including children of an outright-excluded directory.
# Listing subpaths explicitly leaves artifacts/priors/ (paper-anchored
# Optuna search bounds; US-003) implicitly tracked.
artifacts/weights/
artifacts/optuna_thz.db
artifacts/dashboard_thumbs/
artifacts/best_hparams/
artifacts/Final_Exp.html
artifacts/figures/
artifacts/summaries/
artifacts/tables/
artifacts/dashboard_*.html
artifacts/all_phases_results.json
artifacts/systematic_results.json
artifacts/final_plan_results.json
artifacts/experiment_log.txt
artifacts/sample_inputs.png
*.optuna_journal.log

# Papers (local references, large PDFs)
papers/
